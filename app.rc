#include <winver.h>
#include "version.h"

1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION APP_VER_MAJOR, APP_VER_MINOR, APP_VER_PATCH, 0
PRODUCTVERSION APP_VER_MAJOR, APP_VER_MINOR, APP_VER_PATCH, 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "ProductName", "Window Focus Highlighter"
            VALUE "FileDescription", "Window Focus Highlighter"
            VALUE "FileVersion", APP_VER_STR
            VALUE "ProductVersion", APP_VER_STR
            VALUE "OriginalFilename", "WindowFocusHighlighter.exe"
            VALUE "LegalCopyright", "MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
